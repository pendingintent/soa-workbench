      "name": "app.py",
      "filePath": "web/app.py",
      "summary": "Main FastAPI application module: defines the app instance, lifespan startup (DB init + sequential schema migrations), CDISC Library concept/specialization fetch-and-cache endpoints, SoA matrix build/render logic, and the bulk of the SoA edit page's inline UI endpoints (cells, superscripts, elements, transition rules) plus XLSX/HTML/PDF/CSV export.",
      "tags": [
        "entry-point",
        "api-handler",
        "fastapi",
        "matrix-rendering",
        "cdisc-integration"
      ],
      "complexity": "complex",
      "languageNotes": "At 7141 lines this is by far the largest module in the project; it mixes route handlers, background-task enrichment functions, and rendering helpers in one file rather than being split into routers like most other domains."
    },
