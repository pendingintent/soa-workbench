        "configuration",
        "constants",
        "codelist",
        "cdisc-ct",
        "environment-variables"
      ],
      "complexity": "simple",
      "languageNotes": "Calls load_dotenv(\"config.env\") itself so configured values are available regardless of import order relative to app.py."
    },
