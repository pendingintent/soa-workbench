# ============================================================
# SoA Workbench – Runtime Configuration
# ============================================================
# Copy this file to the project root and edit as needed.
# Loaded automatically at startup via python-dotenv.
#
# IMPORTANT – Secrets (CDISC_API_KEY, CDISC_SUBSCRIPTION_KEY)
# must be set in your shell environment; do NOT add them here.
# ============================================================


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# IP address the web server binds to.
SOA_BUILDER_HOST=0.0.0.0

# TCP port the web server listens on.
SOA_BUILDER_PORT=8008


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Path to the SQLite database file.
# Relative paths are resolved from the working directory.
SOA_BUILDER_DB=soa_builder_web.db


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Set to 1 to enable DEBUG-level log output.
SOA_BUILDER_DEBUG=0


# ------------------------------------------------------------
# File System
# ------------------------------------------------------------

# Root directory for normalized SOA output files.
SOA_BUILDER_NORMALIZED_ROOT=normalized


# ------------------------------------------------------------
# CDISC Library API
# ------------------------------------------------------------

# Base URL for the CDISC Library Cosmos v2 API
# (biomedical concepts and dataset specializations).
CDISC_BC_API_BASE_URL=https://api.library.cdisc.org/api/cosmos/v2

# Set to 1 to skip all remote CDISC Library API calls.
# Useful for offline development or testing.
CDISC_SKIP_REMOTE=0

# Path to a local JSON file (or inline JSON) that overrides the
# remote biomedical concepts response. Useful for testing.
# CDISC_CONCEPTS_JSON=

# Path to a local JSON file (or inline JSON) that overrides the
# remote SDTM dataset specializations response.
# CDISC_SDTM_SPECIALIZATIONS_JSON=


# ------------------------------------------------------------
# Caching
# ------------------------------------------------------------

# Time-to-live (in seconds) for all CDISC Library API response
# caches. Default is 3600 (1 hour).
SOA_BUILDER_CACHE_TTL=3600


# ------------------------------------------------------------
# HTTP
# ------------------------------------------------------------

# Timeout (in seconds) for outbound HTTP requests to the
# CDISC Library API.
CDISC_REQUEST_TIMEOUT=15


# ------------------------------------------------------------
# Biomedical Concept Property Population
# ------------------------------------------------------------

# Set to 0 to disable eager population of biomedical concept
# properties at startup (enables lazy loading instead).
SOA_EAGER_BCP_POPULATION=1
